# ---- Sleeper (no auth; public read-only API) ----
# Numeric ID from https://sleeper.com/leagues/<LEAGUE_ID>/team
SLEEPER_LEAGUE_ID=

# ---- Yahoo Fantasy Sports API (OAuth2) ----
# Register an app at https://developer.yahoo.com/apps/create/
#   API Permissions: Fantasy Sports -> Read/Write
#   Redirect URI:    https://localhost:8099/callback
# See docs/yahoo-setup.md
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8099/callback
# Filled after `ff yahoo login`; format: nfl.l.<league_id>  e.g. 449.l.123456
YAHOO_LEAGUE_KEY=

# ---- FantasyPros API ----
# https://www.fantasypros.com/api/  (paid key, sent as x-api-key header)
FANTASYPROS_API_KEY=
